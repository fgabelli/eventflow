{# Atteso: variabile `post` (item della collection posts) #}                                                                                                              
<article class="post-card">                                                                                                                                               
  <a href="{{ post.url }}" class="post-card-link" aria-label="{% if (lang or 'it') == 'en' %}Read{% else %}Leggi{% endif %}: {{ post.data.title }}">
    <div class="post-card-media">                                                                                                                                         
      {% if post.data.image %}
        <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt or '' }}" loading="lazy" width="800" height="420" />                                                  
      {% else %}                                                                                                                                                          
        <div class="post-card-placeholder" aria-hidden="true"></div>                                                                                                      
      {% endif %}                                                                                                                                                         
      {% if post.data.category %}<span class="post-card-category">{{ post.data.category }}</span>{% endif %}                                                              
    </div>
    <div class="post-card-body">                                                                                                                                          
      <h2 class="post-card-title">{{ post.data.title }}</h2>
      <p class="post-card-desc">{{ post.data.description }}</p>                                                                                                           
      <div class="post-card-meta">                                                                                                                                        
        <time datetime="{{ post.date | isoDate }}">{% if (lang or 'it') == 'en' %}{{ post.date | dateEn }}{% else %}{{ post.date | dateIta }}{% endif %}</time>
        <span aria-hidden="true">·</span>                                                                                                                                 
        <span>{{ post.templateContent | readingTime }} min</span>                                                                                                         
      </div>                                                                                                                                                              
    </div>                                                                                                                                                                
  </a>          
</article>
