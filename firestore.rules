rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if user is the document owner
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Helper: check if user is member of org with given role
    function isOrgMember(orgId) {
      return isAuth() && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function getOrgMemberRole(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role;
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId) && getOrgMemberRole(orgId) in ['owner', 'admin'];
    }

    function isOrgStaff(orgId) {
      return isOrgMember(orgId) && getOrgMemberRole(orgId) in ['owner', 'admin', 'staff'];
    }

    function isOrgBlocked(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.get('blocked', false) == true;
    }

    // helper: si può pubblicare solo con email verificata (o org con grandfathering) e org non bloccata
    function canPublish(data) {
      return data.status != 'published'
        || (
          (request.auth.token.email_verified == true
            || get(/databases/$(database)/documents/organizations/$(data.orgId)).data.get('trusted', false) == true)
          && get(/databases/$(database)/documents/organizations/$(data.orgId)).data.get('blocked', false) != true
        );
    }

    function isDisposable(email) {
      return email != null && email.lower().matches('.*@(litedl\\.com|aiqseo\\.com|mailinator\\.com|guerrillamail\\.com|10minutemail\\.com|tempmail\\.com|yopmail\\.com|sharklasers\\.com|trashmail\\.com|temp-mail\\.org|dispostable\\.com|getnada\\.com|mohmal\\.com|emailondeck\\.com|throwawaymail\\.com|fakeinbox\\.com|maildrop\\.cc|mailnesia\\.com|mintemail\\.com|mytemp\\.email|nada\\.email|burnermail\\.io|tempail\\.com|tempmailaddress\\.com|tmpmail\\.net|tmpmail\\.org|wegwerfmail\\.de)$');
    }

    // ─── Users ─────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ─── Organizations ─────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.token.email_verified == true && !isDisposable(request.auth.token.email);
      allow update: if isOrgAdmin(orgId);
      allow delete: if isAuth() && getOrgMemberRole(orgId) == 'owner';

      // Public organization profile (only safe fields: name, logo, primaryColor, blocked, trusted, plan)
      match /public/{docId} {
        allow read: if true;
        allow write: if isOrgAdmin(orgId);
      }

      // Organization members subcollection (auth required)
      match /members/{memberId} {
        allow read: if isAuth();
        // Allow org creator to add themselves as first member (owner),
        // or existing admins to add new members
        allow create: if isOrgAdmin(orgId)
          || (isAuth() && memberId == request.auth.uid && request.resource.data.role == 'owner');
        allow update: if isOrgAdmin(orgId);
        allow delete: if isAuth() && getOrgMemberRole(orgId) == 'owner';
      }
    }

    // ─── Events ────────────────────────────────────────────────
    match /events/{eventId} {
      // Public read: anyone can view event details (for registration page)
      allow read: if true;
      allow create: if isAuth() && isOrgAdmin(request.resource.data.orgId) && !isOrgBlocked(request.resource.data.orgId) && canPublish(request.resource.data);
      // Only authenticated staff can update events
      // (attendeesCount & timeSlots are updated server-side by Cloud Functions)
      allow update: if isAuth() && isOrgStaff(resource.data.orgId) && !isOrgBlocked(resource.data.orgId) && canPublish(request.resource.data);
      allow delete: if isAuth() && isOrgAdmin(resource.data.orgId);
    }

    // ─── Attendees ─────────────────────────────────────────────
    match /attendees/{attendeeId} {
      allow read: if isAuth() && isOrgMember(resource.data.orgId);
      // Allow org staff OR public self-registration (must have required fields)
      allow create: if !isOrgBlocked(request.resource.data.orgId) && (
        (isAuth() && isOrgStaff(request.resource.data.orgId))
        || (
          request.resource.data.keys().hasAll(['eventId', 'orgId', 'firstName', 'lastName', 'email', 'qrCode', 'status'])
          && request.resource.data.firstName is string && request.resource.data.firstName.size() <= 80
          && request.resource.data.lastName is string && request.resource.data.lastName.size() <= 80
          && request.resource.data.email is string && request.resource.data.email.size() <= 254
          && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
          && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.status == 'published'
          && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.orgId == request.resource.data.orgId
        )
      );
      allow update: if isAuth() && isOrgStaff(resource.data.orgId) && !isOrgBlocked(resource.data.orgId);
      allow delete: if isAuth() && isOrgAdmin(resource.data.orgId);
    }

    // ─── Promotions & Offers ────────────────────────────────────
    match /promotions/{promoId} {
      // Public read for customer voucher claim page
      allow read: if true;
      allow create: if isAuth() && isOrgAdmin(request.resource.data.orgId);
      allow update: if (isAuth() && isOrgStaff(resource.data.orgId))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedCount', 'currentSequence', 'updatedAt']));
      allow delete: if isAuth() && isOrgAdmin(resource.data.orgId);
    }

    // ─── Vouchers ───────────────────────────────────────────────
    match /vouchers/{voucherId} {
      // Public read for customer voucher claim page
      allow read: if true;
      // Allow staff creation OR public customer just-in-time claim creation
      allow create: if (isAuth() && isOrgStaff(request.resource.data.orgId))
        || (request.resource.data.status == 'claimed'
            && request.resource.data.keys().hasAll(['promoId', 'orgId', 'code', 'status', 'claimedFirstName', 'claimedLastName', 'claimedEmail', 'expiresAt']));
      // Staff update (redemption/management) OR customer self-claim (only available vouchers)
      allow update: if (isAuth() && isOrgStaff(resource.data.orgId))
        || (resource.data.status == 'available'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedAt', 'expiresAt', 'claimedFirstName', 'claimedLastName', 'claimedEmail', 'claimedPhone', 'paymentStatus']));
      allow delete: if isAuth() && isOrgAdmin(resource.data.orgId);
    }

    // ─── Stripe Checkout Sessions ──────────────────────────────
    match /stripe_checkout_sessions/{sessionId} {
      // Allow org admin to create a checkout session
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && isOrgAdmin(request.resource.data.orgId);
      // Allow session creator or org admins to read session status and checkout URL
      allow read: if isAuth()
        && (resource.data.userId == request.auth.uid || isOrgAdmin(resource.data.orgId));
      // Updates and deletions are only performed server-side by Cloud Functions
      allow update, delete: if false;
    }

    // ─── Subscriptions ──────────────────────────────────────────
    match /subscriptions/{orgId} {
      allow read: if isAuth() && isOrgMember(orgId);
      allow write: if false;
    }
  }
}
